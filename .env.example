# All optional. Copy to .env.local for local development.

# Free CoinGecko Demo key. Prices work without it; with it the rate limit is higher.
COINGECKO_API_KEY=

# Public address for canonical links and the sitemap (defaults to hashwire.vercel.app on Vercel).
SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to load nothing from Google.
GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification: just the content="…" value.
GOOGLE_SITE_VERIFICATION=

# Set to 1 to use the saved feed and price snapshots instead of live data (ignored in Vercel production).
NEWS_SAMPLE_DATA=
